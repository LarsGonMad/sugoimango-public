	quest.77E0DA20AF7FF29D.quest_desc: ["&lSophisticated Storage&r adds better variants of Chests and Barrels."]
	quest.7956CF6B0764E10A.quest_desc: ["The &lDropper Module&r allows the Modular Router to drop items from a configured side."]
